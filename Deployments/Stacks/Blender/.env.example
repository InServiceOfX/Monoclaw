# Copy to .env and adjust. All values have sane defaults in docker-compose.yml.

BLENDER_VERSION=4.2.3
CONTAINER_NAME=blender-starship

# Display GPU index in nvidia-smi/PCI order (NOT CUDA order).
#   Desktop: 0 = GTX 980 Ti (drives DISPLAY=:0)   <-- use this
#   Laptop : set to whatever drives your monitor
BLENDER_GPU_ID=0

# X11 — usually picked up from the host automatically.
# DISPLAY=:0

# Telemetry: http (non-invasive poll, default) | udp (lowest latency)
TELEM_SOURCE=http
TELEM_HTTP_HOST=127.0.0.1
TELEM_HTTP_PORT=8282
TELEM_UDP_PORT=50505

STARSHIP_OBJECT=Starship
DRIVER_FPS=60
