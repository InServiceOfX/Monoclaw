# Profile: Qwen3.8-9B-Distill (Q4_K_M) — fastest quant, 4 slots at full context
#
# Model card: https://huggingface.co/empero-ai/Qwen3.8-9B-Distill-GGUF
# Upstream:   https://huggingface.co/empero-ai/Qwen3.8-9B-Distill
#
# The card calls Q4_K_M the recommended quality/size balance. Here it is the
# throughput profile: smallest weights leave the memory budget free to give
# every one of four concurrent slots the model's full 262144-token window.
#
# Requires a llama.cpp build with Qwen3.5 / Gated DeltaNet support.
#
# Download first:
#   ./fetch-model.sh download empero-ai/Qwen3.8-9B-Distill-GGUF Qwen3.8-9B-Q4_K_M.gguf
#
# ─── Sizing (Apple M4 Pro / 64 GB) ───────────────────────────────────────────
# Weights (Q4_K_M)                     5.38 GiB
# KV cache, 1048576 tokens, q8_0      17.00 GiB
# Compute buffers + recurrent state   ~2    GiB
#                                    ─────────
#                                    ~24.4 GiB
#
# That is a large allocation to make up front. If startup stalls or memory
# pressure goes yellow, drop ctx_size to 524288 (128K per slot, 8.5 GiB of KV)
# before touching anything else.

# ─── Model ────────────────────────────────────────────────────────────────────
hf_repo: empero-ai/Qwen3.8-9B-Distill-GGUF
hf_file: Qwen3.8-9B-Q4_K_M.gguf

# ─── Server ───────────────────────────────────────────────────────────────────
server:
  # Use 127.0.0.1 for local-only serving. Use 0.0.0.0 to expose on your LAN.
  host: 127.0.0.1
  port: 8080

n_gpu_layers: 99

# ─── Context ─────────────────────────────────────────────────────────────────
# -c is the total across slots: 1048576 / 4 = 262144 per request, exactly the
# native window. Going higher per slot would need YaRN (see ADDING-A-MODEL.md).
ctx_size: 1048576
parallel: 4

n_predict: -1

# ─── Flash Attention ──────────────────────────────────────────────────────────
flash_attn: "on"

# ─── Batching ────────────────────────────────────────────────────────────────
batch_size: 2048
ubatch_size: 2048
cont_batching: true
cache_ram: 8192

# ─── KV Cache Quantization ───────────────────────────────────────────────────
# Required at this context size — f16 would cost 32 GiB of KV instead of 17.
# At long context the cache is bandwidth-bound, so the smaller footprint tends
# to pay for the dequantization work rather than costing extra.
cache_type_k: q8_0
cache_type_v: q8_0

# ─── macOS / Metal ───────────────────────────────────────────────────────────
mlock: true
threads: 10
priority: 1

# ─── Chat Template & Reasoning ───────────────────────────────────────────────
jinja: true
reasoning_format: deepseek

# ─── Sampling Defaults ───────────────────────────────────────────────────────
# Model card recipe. Do not set temp: 0 — greedy decoding is a documented
# repetition-loop failure mode, and 4-bit is the quant most prone to it.
temp: 0.6
top_p: 0.95
top_k: 20

# 4-bit benefits more than the larger quants from an anti-repetition nudge on
# long generations. Enable if you see loops.
# presence_penalty: 1.5

# ─── Experimental / Optional ─────────────────────────────────────────────────
# spec_default: true

# extra_args:
#   - --slots
