# Profile: Qwen3.5-9B Claude 4.6 Opus Reasoning Distilled v2 (Q4_K_M)
# Source: Jackrong/Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF
#
# Apple M4 Pro / 64GB target:
#   256K binary context, all layers on GPU (Metal), 4 server slots.
#   262144 = 256 * 1024.
#
# MacBook Pro M5 / 32GB suggestion:
#   ctx_size: 131072
#   parallel: 1 or 2
#   cache_ram: 2048

# ─── Model ────────────────────────────────────────────────────────────────────
model_path: /Users/ernestyeung/.cache/huggingface/hub/models--Jackrong--Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF/snapshots/b4d6d8e3760a202ca208a7c8aabb88b2ac18a10a/Qwen3.5-9B.Q4_K_M.gguf

# ─── Server ───────────────────────────────────────────────────────────────────
server:
  # Use 127.0.0.1 for local-only serving. Use 0.0.0.0 to expose on your LAN.
  host: 127.0.0.1
  port: 8080

# ─── GPU & Layers ─────────────────────────────────────────────────────────────
# -ngl 99: offload all layers to Metal GPU.
n_gpu_layers: 99

# ─── Context ─────────────────────────────────────────────────────────────────
# -c 262144: 256K binary context.
ctx_size: 262144

# ─── Parallelism ──────────────────────────────────────────────────────────────
# -np 4: four server slots for concurrent requests.
parallel: 4
# Lower to 1 for reduced KV-cache memory pressure:
# parallel: 1

# ─── Token Prediction ────────────────────────────────────────────────────────
# -n -1: unlimited generation length.
n_predict: -1

# ─── Flash Attention ──────────────────────────────────────────────────────────
# Metal supports flash attention in recent llama.cpp builds.
flash_attn: "on"

# ─── Batching ────────────────────────────────────────────────────────────────
# Logical and physical batch size for prompt processing.
batch_size: 2048
ubatch_size: 2048

# Continuous batching: enabled by default in recent llama.cpp builds.
# Set false only when debugging request scheduling behavior.
cont_batching: true

# Prompt cache RAM limit in MiB. 8192 is reasonable on this 64GB Mac mini.
# For 32GB machines, use 2048 or 0 to disable prompt cache.
cache_ram: 8192

# ─── KV Cache Quantization ───────────────────────────────────────────────────
# q8_0 is a good balance of quality/memory on Apple Silicon with ample RAM.
cache_type_k: q8_0
cache_type_v: q8_0

# ─── Chat Templates ──────────────────────────────────────────────────────────
jinja: true

# ─── Reasoning / Thinking ────────────────────────────────────────────────────
# Qwen3.5 supports <think>...</think> reasoning mode.
# reasoning: auto

# Optional: pass chat-template kwargs as JSON. Useful for templates that support
# switches such as non-thinking mode.
# chat_template_kwargs:
#   thinking: false

# ─── Experimental / Optional ─────────────────────────────────────────────────
# Enable llama.cpp's default speculative decoding config only after testing.
# spec_default: true

# Escape hatch for new llama-server flags before launch.sh supports them.
# extra_args:
#   - --slots
