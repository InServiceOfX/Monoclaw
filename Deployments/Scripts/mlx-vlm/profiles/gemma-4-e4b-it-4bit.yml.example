# Profile: mlx-community/gemma-4-e4b-it-4bit (MLX-VLM)
# Multimodal vision-language model — Gemma 4 E4B IT, 4-bit quantized for MLX.
# Model card: https://huggingface.co/mlx-community/gemma-4-e4b-it-4bit
#
# Copy this to gemma-4-e4b-it-4bit.yml and edit model_path.

paths:
  # REQUIRED: Local path to the MLX model weights.
  # Can be the HF cache repo root (auto-resolves snapshots/) or a direct snapshot dir.
  model_path: /Users/YOU/.cache/huggingface/hub/models--mlx-community--gemma-4-e4b-it-4bit

serve:
  trust_remote_code: true
  prefill_step_size: 512     # Conservative; try 1024/2048 if you have memory headroom
  max_kv_size: 65536
  kv_bits: 4.0               # Quantize KV cache for lower memory; omit for full precision
  # kv_quant_scheme: uniform  # or "turboquant" for fractional kv_bits
  # kv_group_size: 64
  # adapter_path: /path/to/adapter  # Optional LoRA adapter

chat:
  max_tokens: 1024
  temperature: 0.2
  max_kv_size: 65536
  prefill_step_size: 512
