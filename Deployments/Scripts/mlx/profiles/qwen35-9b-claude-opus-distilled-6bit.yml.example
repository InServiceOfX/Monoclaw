# Profile: Jackrong/MLX-Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2 (6-bit)
#
# Model card: https://huggingface.co/Jackrong/MLX-Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2-6bit
# Upstream:   https://huggingface.co/Jackrong/Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2
# Base arch:  Qwen3.5-9B (linear + full attention hybrid, 4096 hidden, 12288 intermediate)
# Quant:      6-bit affine, group_size=64
#
# Notes on recommended values:
# - 6-bit retains more of the original model's reasoning quality compared to 4-bit.
#   Expect ~7-8 GB memory usage — comfortable on 16 GB+ Mac mini.
# - Because 6-bit has less quantization noise, you can push temperature closer to 1.0
#   for thinking modes without as much risk of degenerate output.
# - repetition_penalty ~1.15 is still recommended for quantized reasoning stability.
# - Same Qwen3.5 chat template with enable_thinking toggle support.
#
# Copy this to qwen35-9b-claude-opus-distilled-6bit.yml and edit model_path.

paths:
  # REQUIRED: Local path to the MLX model weights.
  model_path: /Users/YOU/.cache/huggingface/hub/models--Jackrong--MLX-Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2-6bit

serve:
  trust_remote_code: true
  # decode_concurrency: 4
  # prompt_concurrency: 2

chat:
  max_kv_size: 32768
  default_system_prompt: "You are a helpful, thoughtful assistant. Think step by step before answering."
  trust_remote_code: true

# Mode-specific sampling defaults for this model.
# 6-bit can handle slightly more aggressive sampling than 4-bit.
modes:
  thinking_general:
    enable_thinking: true
    temperature: 1.0        # Full temp — 6-bit handles it well for reasoning
    top_p: 0.95
    top_k: 20
    min_p: 0.0
    max_tokens: 8192
    system_prompt: "You are a helpful, thoughtful assistant. Think step by step before answering."

  thinking_coding:
    enable_thinking: true
    temperature: 0.6
    top_p: 0.95
    top_k: 20
    min_p: 0.0
    max_tokens: 8192
    system_prompt: "You are an expert programmer. Be precise and correct."

  instruct_general:
    enable_thinking: false
    temperature: 0.7
    top_p: 0.8
    top_k: 20
    min_p: 0.05
    max_tokens: 4096
    system_prompt: "You are a helpful assistant."

  instruct_reasoning:
    enable_thinking: false
    temperature: 1.0
    top_p: 1.0
    top_k: 40
    min_p: 0.0
    max_tokens: 4096
    system_prompt: "You are a careful reasoning assistant."
