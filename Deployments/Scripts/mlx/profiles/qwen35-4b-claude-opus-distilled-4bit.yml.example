# Jackrong/MLX-Qwen3.5-4B-Claude-4.6-Opus-Reasoning-Distilled-v2 (4-bit)
# ~2.5 GB RAM. Much faster prefill than 9B. Good for quick queries and OpenClaw agent use.

paths:
  model_path: /Users/YOU/.cache/huggingface/hub/models--Jackrong--MLX-Qwen3.5-4B-Claude-4.6-Opus-Reasoning-Distilled-v2-4bit

serve:
  trust_remote_code: true
  prefill_step_size: 4096
  prompt_cache_size: 4
  decode_concurrency: 2
  prompt_concurrency: 1

chat:
  max_kv_size: 32768
  default_system_prompt: "You are a helpful, thoughtful assistant. Think step by step before answering."
  trust_remote_code: true

modes:
  thinking_general:
    enable_thinking: true
    temperature: 0.8
    top_p: 0.95
    top_k: 20
    min_p: 0.0
    max_tokens: 4096
    system_prompt: "You are a helpful, thoughtful assistant. Think step by step before answering."

  thinking_coding:
    enable_thinking: true
    temperature: 0.6
    top_p: 0.95
    top_k: 20
    min_p: 0.0
    max_tokens: 4096
    system_prompt: "You are an expert programmer. Be precise and correct."

  instruct_general:
    enable_thinking: false
    temperature: 0.7
    top_p: 0.8
    top_k: 20
    min_p: 0.05
    max_tokens: 2048
    system_prompt: "You are a helpful assistant."

  instruct_reasoning:
    enable_thinking: false
    temperature: 1.0
    top_p: 1.0
    top_k: 40
    min_p: 0.0
    max_tokens: 2048
    system_prompt: "You are a careful reasoning assistant."
