# Profile: Qwen3.5-9B Claude 4.6 Opus Reasoning Distilled v2 (Q8_0)
# Source: Jackrong/Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF
#
# Q8_0: highest quality quantization, near-lossless vs BF16.
#   Weights file: 8.9 GB on disk.
#   VRAM budget on RTX 3060 12 GB:
#     8.9 GB weights + ~1.75 GB KV cache (q4_0, 64K ctx) ≈ 10.65 GB  ← safe default
#     8.9 GB weights + ~3.5  GB KV cache (q4_0, 128K ctx) ≈ 12.4 GB  ← exceeds 12 GB
#   → ctx_size set to 65536 (64K) for the 12 GB card.
#     For ≥24 GB VRAM (e.g. RTX 3090/4090), raise to 131072 freely.
#
# Full server options: https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md

# ─── Model ────────────────────────────────────────────────────────────────────
# Path to the GGUF file relative to the mounted /models volume.
# The volume mount in config.yml maps the host LLM dir → /models inside container.
model_path: /models/Jackrong/Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF/Qwen3.5-9B.Q8_0.gguf

# Host-side absolute path (reference only, not used by launch.sh)
host_model_path: /media/propdev/9dc1a908-7eff-4e1c-8231-ext4/home/propdev/Data/Models/LLM/Jackrong/Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF/Qwen3.5-9B.Q8_0.gguf

# ─── Vision / Multimodal ──────────────────────────────────────────────────────
# --mmproj PATH: Vision projector GGUF for multimodal (image) input.
#   Qwen3.5-9B is a vision-language model (pipeline_tag: image-text-to-text).
#   config.json has full vision_config + image_token_id/video_token_id.
#   The mmproj-BF16.gguf (880 MB) is the ViT encoder projector.
#   Omit (or comment out) to run text-only and save the 880 MB VRAM.
#   Note: distillation SFT was text-only data — vision works at base quality.
mmproj_path: /models/Jackrong/Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF/mmproj-BF16.gguf

# ─── Server ───────────────────────────────────────────────────────────────────
server:
  host: 0.0.0.0        # --host: bind address inside container (always 0.0.0.0 for Docker)
  port: 8080            # --port: server listen port (mapped to host via -p)

# ─── GPU & Layers ─────────────────────────────────────────────────────────────
# -ngl, --n-gpu-layers N: How many model layers to offload to GPU VRAM.
#   99 = all layers on GPU (no CPU offload). Q8_0 at 8.9 GB fits on 12 GB with
#   reduced context. If you see OOM, lower ctx_size before reducing n_gpu_layers.
n_gpu_layers: 99

# ─── Context & Batching ──────────────────────────────────────────────────────
# -c, --ctx-size N: Total context window in tokens. 0 = use model default.
#   64K (65536) is the safe default for Q8_0 on 12 GB VRAM.
#   Raise to 131072 (128K) only on cards with ≥24 GB VRAM.
ctx_size: 65536

# -np, --parallel N: Number of server slots (concurrent request streams).
#   1 = single user. Saves ~190 MB VRAM vs multiple slots.
parallel: 1

# -b, --batch-size N: Logical max batch size for prompt processing (default: 2048).
#   Larger = faster prefill but more VRAM spike. 2048 is a good default.
# batch_size: 2048

# -ub, --ubatch-size N: Physical max batch size (default: 512).
#   Controls the actual GPU kernel batch dimension. Rarely needs tuning.
# ubatch_size: 512

# ─── Flash Attention ──────────────────────────────────────────────────────────
# -fa, --flash-attn [on|off|auto]: Flash Attention for constant-speed generation.
#   Without it, generation slows as context fills. Always use "on" for CUDA.
flash_attn: "on"

# ─── KV Cache Quantization ───────────────────────────────────────────────────
# -ctk / -ctv: Data type for KV cache K and V values.
#   q4_0 compresses ~4x vs f16 — critical for fitting any context on 12 GB.
#   Minimal quality loss for most tasks; q8_0 or f16 if you have VRAM headroom.
cache_type_k: q4_0
cache_type_v: q4_0

# ─── Token Prediction ────────────────────────────────────────────────────────
# -n, --n-predict N: Max tokens to generate per request (-1 = infinite).
n_predict: -1

# ─── CPU Threads ──────────────────────────────────────────────────────────────
# -t, --threads N: CPU threads for generation (fallback / mixed offload).
#   -1 = auto-detect. Only matters if n_gpu_layers < total layers.
# threads: -1

# ─── Reasoning / Thinking ────────────────────────────────────────────────────
# --reasoning [on|off|auto]: Enable <think>...</think> reasoning tags.
#   "auto" detects from chat template. Qwen3.5-Distilled supports thinking mode.
reasoning: auto

# --reasoning-format FORMAT: How to return thinking content.
#   "deepseek" = puts thoughts in message.reasoning_content (OpenAI extension)
#   "none" = leaves <think> tags in message.content
# reasoning_format: deepseek

# ─── Jinja Templates ─────────────────────────────────────────────────────────
# --jinja: Use Jinja template engine for chat (default: enabled in recent llama.cpp).
#   The GGUF embeds the correct Qwen3 chat template. Override only if needed.
# jinja: true

# ─── Monitoring ───────────────────────────────────────────────────────────────
# --metrics: Enable Prometheus-compatible /metrics endpoint.
# metrics: true

# ─── Advanced (rarely needed) ────────────────────────────────────────────────
# --mlock: Force model to stay in RAM (no swap). Good for dedicated servers.
# --rope-scaling {none,linear,yarn}: RoPE scaling for extended context.
# --rope-freq-base N: RoPE base freq for NTK-aware scaling.
# --cache-reuse N: Min chunk for KV cache reuse via shifting.
# --slot-save-path PATH: Save/restore slot KV cache to disk.
# --api-key KEY: Require API key for all requests.
#
# Full list: https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md
