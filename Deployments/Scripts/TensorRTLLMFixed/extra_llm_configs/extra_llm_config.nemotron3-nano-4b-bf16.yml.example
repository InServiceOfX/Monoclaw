# Extra LLM API config for NVIDIA-Nemotron-3-Nano-4B-BF16 on RTX 3060 (12GB)
# Passed via: trtllm-serve serve ... --config <this-file>
#
# IMPORTANT: nemotron_h is a Mamba-2 hybrid architecture (mostly SSM + 4 attention layers).
# It requires specific settings that differ from pure-transformer models:
#   - disable_overlap_scheduler: true  (required for Mamba hybrid — per NVIDIA README)
#   - cuda_graph_config: required for stable inference
#   - moe_config.backend: CUTLASS (per NVIDIA README)
#   - enable_block_reuse: false (per NVIDIA README — don't change this)
#
# Source: NVIDIA-Nemotron-3-Nano-4B-BF16/README.md trtllm-serve example

# ── KV cache ──────────────────────────────────────────────────────────────────
# BF16 weights ~8GB, leaves ~4GB free on 3060 12GB.
# dtype: auto lets TRT-LLM pick the right KV dtype.
# enable_block_reuse: false — required per NVIDIA README for this architecture.
kv_cache_config:
  dtype: "auto"
  enable_block_reuse: false

# ── CUDA graph ────────────────────────────────────────────────────────────────
# Required for nemotron_h Mamba hybrid. Per NVIDIA README.
# max_batch_size must match serve.max_batch_size.
cuda_graph_config:
  max_batch_size: 32
  enable_padding: true

# ── Overlap scheduler ─────────────────────────────────────────────────────────
# MUST be disabled for Mamba hybrid architecture. Per NVIDIA README.
disable_overlap_scheduler: true

# ── MoE backend ───────────────────────────────────────────────────────────────
# CUTLASS backend required. Per NVIDIA README.
moe_config:
  backend: CUTLASS
