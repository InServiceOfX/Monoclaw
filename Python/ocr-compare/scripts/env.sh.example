# Copy to scripts/env.sh (gitignored) and edit to override defaults.
# Anything you don't set falls back to the defaults in scripts/_paths.sh.

# Base dir for the heavy artifacts (venvs + weights). Default: the Samsung disk.
# export OCR_STORAGE=/media/ernest/Samsung980ProPCI/ocr-compare

# Split venvs and weights onto different disks if you like:
# export OCR_VENV_DIR=/media/ernest/Samsung980ProPCI/ocr-compare/venvs
# export OCR_WEIGHTS_DIR=/media/ernest/Samsung980ProPCI/ocr-compare/weights

# Python interpreter for the nougat/marker venvs (they pin 3.10).
# export OCR_PYTHON=3.10

# CUDA build of torch. Change the index if your CUDA toolkit differs.
# export TORCH_SPEC="torch==2.12.0 torchvision==0.27.0"
# export CUDA_INDEX=https://download.pytorch.org/whl/cu130

# Point nougat at an already-downloaded checkpoint dir to skip the download:
# export NOUGAT_CHECKPOINT=/some/path/nougat-0.1.0-small
